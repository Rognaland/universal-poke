# Dockerfile.hardhat
FROM node:20

# Use apt to install netcat so healthchecks can use it
RUN apt-get update && apt-get install -y netcat-openbsd && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package*.json ./
# Install dependencies (use legacy-peer-deps for compatibility with some older packages)
RUN npm install --legacy-peer-deps
COPY . .

EXPOSE 8545

# Start hardhat node, wait briefly for it to accept connections, run deploy (ESM), then keep the node process alive
CMD ["/bin/sh", "-c", "npx hardhat node --hostname 0.0.0.0"]