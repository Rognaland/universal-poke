// Firestore rules snippet: deny client writes to payout collections
service cloud.firestore {
  match /databases/{database}/documents {
    // Block direct client writes to payouts and processedPayouts
    match /payouts/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.requesterUid; // adjust as needed
      allow write: if false; // writes must be performed by trusted server functions
    }
    match /processedPayouts/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.requesterUid; // optional
      allow write: if false; // writes must be performed by trusted server functions
    }

    // Allow everything else by default for now (adjust rules to tighten in prod)
    match /{document=**} {
      allow read, write: if false; // lock down by default and open specific paths as needed
    }
  }
}
